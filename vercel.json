{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "memory": 1024,
      "includeFiles": "final_model/model.pkl",
      "excludeFiles": "{Artifacts/**,08_22_2025_00_20_26/**,Network_Data/**,mlruns/**,logs/**,tests/**,frontend/**,deploy/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
