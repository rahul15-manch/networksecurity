# ==========================================
# Network Security Phishing Detection Service
# Environment Configuration Template
# ==========================================

# API Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Path to trained NetworkModel artifact
MODEL_PATH=final_model/model.pkl

# Optional MLOps and Database Configuration
# Local inference functions completely without these credentials.
# MLFLOW_TRACKING_URI=
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
# MONGO_DB_URL=

# Vercel Serverless Function Configuration
# Enables Fluid Compute to expand uncompressed bundle limits up to 5 GB (100% free on Hobby tier)
VERCEL_SUPPORT_LARGE_FUNCTIONS=1
